{
  "name": "travelplanner-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test src/features/auth/lib/*.test.mjs src/features/planner/lib/*.test.mjs src/features/planner/model/*.test.mjs src/features/planner/utils/*.test.mjs src/shared/api/*.test.mjs",
    "test:api": "node --experimental-strip-types --test src/shared/api/client.test.mjs",
    "test:planner": "node --experimental-strip-types --test src/features/planner/lib/*.test.mjs",
    "test:transport": "node --experimental-strip-types --test src/features/planner/lib/transport-options.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "maplibre-gl": "^5.24.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.7.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.12.0",
    "eslint-config-next": "^15.0.0",
    "typescript": "^5.6.3"
  }
}
