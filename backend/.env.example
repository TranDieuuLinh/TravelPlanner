# Application
APP_NAME=TravelPlanner API
APP_ENV=local

# Database for backend/scripts running on the host.
# Docker Compose overrides the hostname to `postgres` inside containers.
DATABASE_URL=postgresql+psycopg://travelplanner:travelplanner@localhost:5432/travelplanner

# CORS
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Authentication
JWT_SECRET=local-only-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=1440
REFRESH_TOKEN_DAYS=7
AUTH_COOKIE_SECURE=false

# MoMo Payment (Sandbox)
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=F8B39C29B7F5
MOMO_SECRET_KEY=K95549280BDF0E35417241123A0CE8A
MOMO_API_URL=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:3000/orders/{orderId}/result
MOMO_IPN_URL=http://localhost:8000/api/payments/webhooks/momo

# LLM Settings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_STT_API_KEYS=
GEMINI_OCR_API_KEYS=
GEMINI_CAPTION_API_KEYS=
GEMINI_PRICE_API_KEYS=
GEMINI_PRICE_MODEL=gemini-3.5-flash-lite
GEMINI_PRICE_MIN_INTERVAL_SECONDS=4
PRICE_SEARCH_PROVIDER=google_selenium
GOOGLE_WEB_SEARCH_TIMEOUT_SECONDS=60
GOOGLE_WEB_SEARCH_MIN_INTERVAL_SECONDS=8
GOOGLE_SELENIUM_PAGE_LOAD_WAIT_SECONDS=3
GOOGLE_SELENIUM_POST_SEARCH_DELAY_SECONDS=1
TAVILY_API_KEY=
TAVILY_TIMEOUT_SECONDS=30

# Conversation Supervisor
CONVERSATION_SUPERVISOR_ENABLED=true
CONVERSATION_SUPERVISOR_LLM_ENABLED=true
AUTO_PLAN_MUTATION_ENABLED=true
CONVERSATION_STREAMING_ENABLED=true
CONVERSATION_TURN_TIMEOUT_SECONDS=120.0
CONVERSATION_TURN_STALE_AFTER_SECONDS=300.0

# Candidate Review
CANDIDATE_REVIEW_ENABLED=false

# Weather
WEATHER_ENABLED=false
WEATHERAPI_KEY=
WEATHERAPI_BASE_URL=https://api.weatherapi.com/v1

# Conversational Backup
CONVERSATIONAL_BACKUP_ENABLED=true

# Partner Search
PARTNER_SEARCH_ENABLED=false

# Realtime Collaboration
REALTIME_COLLABORATION_ENABLED=false

# Place Resolver
PLACE_RESOLVER_PROVIDER=provisional

# Route Provider
ROUTE_PROVIDER=valhalla
ITINERARY_OPTIMIZER_MODE=route_first

# Valhalla
VALHALLA_BASE_URL=http://localhost:8002
VALHALLA_TIMEOUT_SECONDS=15.0
VALHALLA_MIN_INTERVAL_SECONDS=0.0

# OpenTripPlanner
OPENTRIPPLANNER_BASE_URL=http://localhost:8080/otp/gtfs/v1
OPENTRIPPLANNER_TIMEOUT_SECONDS=35.0
OPENTRIPPLANNER_SCHEDULE_STATUS=current

# Google Maps Scraper
GOOGLE_MAPS_SCRAPER_EXECUTABLE=google-maps-scraper
GOOGLE_MAPS_SCRAPER_TIMEOUT_SECONDS=90.0
GOOGLE_MAPS_SCRAPER_MAX_ALIAS_QUERIES=2
GOOGLE_MAPS_SCRAPER_MAX_CONCURRENCY=2
GOOGLE_MAPS_SCRAPER_CACHE_TTL_SECONDS=600
GOOGLE_MAPS_SCRAPER_CACHE_MAX_ENTRIES=512

# Database Place Resolver
DATABASE_PLACE_RESOLVER_TOP_K=5
DATABASE_PLACE_RESOLVER_MINIMUM_SCORE=0.82
DATABASE_PLACE_RESOLVER_MINIMUM_MARGIN=0.08

# YouTube Transcript Worker
YOUTUBE_TRANSCRIPT_MIN_INTERVAL_SECONDS=1.0
YOUTUBE_TRANSCRIPT_WORKER_URL=
YOUTUBE_TRANSCRIPT_WORKER_TOKEN=
YOUTUBE_TRANSCRIPT_WORKER_TIMEOUT_SECONDS=20.0

# URL Reel
PRELOAD_URL_REEL_MODELS=false
URL_IMPORT_WORKER_CONCURRENCY=3
URL_REEL_GEMINI_STT_MIN_INTERVAL_SECONDS=2.0
URL_REEL_STT_CHUNK_SECONDS=60.0
URL_REEL_STT_MAX_CONCURRENCY=3
URL_REEL_STT_OVERLAP_SECONDS=2.0
URL_REEL_MAX_FRAMES=72
URL_REEL_MIN_FRAME_INTERVAL_SECONDS=1.0
URL_REEL_FRAME_WIDTH=960
URL_REEL_VISION_BATCH_SIZE=10
URL_REEL_VISION_MAX_CONCURRENCY=5
URL_REEL_VISION_MEDIA_RESOLUTION=MEDIA_RESOLUTION_MEDIUM
# Bound provider/media work so one bad URL cannot block the FIFO indefinitely.
URL_REEL_NETWORK_TIMEOUT_SECONDS=30
URL_REEL_SUBPROCESS_TIMEOUT_SECONDS=180
# Public web-page import uses a bounded HTTP fetch before Trafilatura extraction.
WEB_PAGE_TIMEOUT_SECONDS=15
WEB_PAGE_MAX_BYTES=5242880
WEB_PAGE_MAX_REDIRECTS=5
WEB_PAGE_MAX_TEXT_CHARS=60000
URL_IMPORT_JOB_TIMEOUT_SECONDS=900
# Free caption path. Successful public captions are cached in PostgreSQL.
YOUTUBE_TRANSCRIPT_MIN_INTERVAL_SECONDS=1
# Optional operator-owned worker running on a residential connection.
# Configure both values or leave both empty. Never commit the worker token.
YOUTUBE_TRANSCRIPT_WORKER_URL=
YOUTUBE_TRANSCRIPT_WORKER_TOKEN=
YOUTUBE_TRANSCRIPT_WORKER_TIMEOUT_SECONDS=20
EXPLORER_TIMING_LOG_PATH=var/explorer-timings.jsonl
ENABLE_LLM_EXPLORE_FORMATTER=true

# Gemini Caption
GEMINI_CAPTION_TIMEOUT_SECONDS=60.0
GEMINI_CAPTION_MAX_ATTEMPTS=2
GEMINI_AUDIO_MODEL=gemini-3.6-flash
GEMINI_IMAGE_OCR_MODEL=gemini-3.5-flash-lite

# Uploads contributed by users (image/video referenced from trip chats).
USER_POST_MEDIA_DIR=var/user-post-media
USER_POST_IMAGE_MAX_BYTES=15728640
USER_POST_VIDEO_MAX_BYTES=104857600
