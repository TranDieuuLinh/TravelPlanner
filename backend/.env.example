APP_NAME=VSF Travel API
APP_ENV=local
DATABASE_URL=postgresql+psycopg://vsf:vsf@localhost:5432/vsf_travel
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
AUTH_COOKIE_SECURE=false
# MoMo sandbox only. Replace every credential and callback URL per environment.
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=replace-with-momo-sandbox-access-key
MOMO_SECRET_KEY=replace-with-momo-sandbox-secret-key
MOMO_API_URL=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:3000/orders/{orderId}/result
MOMO_IPN_URL=http://localhost:8000/api/payments/webhooks/momo
# One key or a comma-separated key pool. Never commit real keys.
GEMINI_API_KEY=key-api1,key-api2
# Recommended for concurrent URL processing: these pools must not overlap.
GEMINI_STT_API_KEYS=key-stt-1
GEMINI_OCR_API_KEYS=key-ocr-1,key-ocr-2,key-ocr-3
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MIN_INTERVAL_SECONDS=0.0
GEMINI_AUDIO_MODEL=gemini-3.5-flash-lite
GEMINI_IMAGE_OCR_MODEL=gemini-3.5-flash-lite
# Weather forecast integrated into itinerary feasibility. Sign up at
# https://www.weatherapi.com/ for a free tier key. Disabled by default.
WEATHER_ENABLED=false
WEATHERAPI_KEY=replace-with-weatherapi-key
WEATHERAPI_BASE_URL=https://api.weatherapi.com/v1
# Captions are tried first. Long audio uses up to three overlapping requests.
URL_REEL_GEMINI_STT_MIN_INTERVAL_SECONDS=2
URL_REEL_STT_CHUNK_SECONDS=60
URL_REEL_STT_MAX_CONCURRENCY=3
URL_REEL_STT_OVERLAP_SECONDS=2
URL_REEL_MAX_FRAMES=72
URL_REEL_MIN_FRAME_INTERVAL_SECONDS=1.0
URL_REEL_FRAME_WIDTH=960
URL_REEL_VISION_BATCH_SIZE=10
URL_REEL_VISION_MAX_CONCURRENCY=5
URL_REEL_VISION_MEDIA_RESOLUTION=MEDIA_RESOLUTION_MEDIUM
# Bound provider/media work so one bad URL cannot block the FIFO indefinitely.
URL_REEL_NETWORK_TIMEOUT_SECONDS=30
URL_REEL_SUBPROCESS_TIMEOUT_SECONDS=180
URL_IMPORT_JOB_TIMEOUT_SECONDS=900
# Free caption path. Successful public captions are cached in PostgreSQL.
YOUTUBE_TRANSCRIPT_MIN_INTERVAL_SECONDS=1
# Optional operator-owned worker running on a residential connection.
# Configure both values or leave both empty. Never commit the worker token.
YOUTUBE_TRANSCRIPT_WORKER_URL=
YOUTUBE_TRANSCRIPT_WORKER_TOKEN=
YOUTUBE_TRANSCRIPT_WORKER_TIMEOUT_SECONDS=20
EXPLORER_TIMING_LOG_PATH=var/explorer-timings.jsonl
ENABLE_LLM_EXPLORE_FORMATTER=true
PRELOAD_URL_REEL_MODELS=false
# Uploads contributed by users (image/video referenced from trip chats).
USER_POST_MEDIA_DIR=var/user-post-media
USER_POST_IMAGE_MAX_BYTES=15728640
USER_POST_VIDEO_MAX_BYTES=104857600
# Conversational Planner supervisor toggles. The supervisor sits in front of the
# LLM to constrain intents/operations and self-repair invalid JSON output.
CONVERSATION_SUPERVISOR_ENABLED=true
CONVERSATION_SUPERVISOR_LLM_ENABLED=true
# Auto-apply structured plan mutations returned by the LLM, otherwise preview.
AUTO_PLAN_MUTATION_ENABLED=true
# Token-by-token streaming for chat responses (requires supervisor to be on).
CONVERSATION_STREAMING_ENABLED=true
# Per-turn LLM timeout (seconds) and stale-pending sweep horizon.
CONVERSATION_TURN_TIMEOUT_SECONDS=120
CONVERSATION_TURN_STALE_AFTER_SECONDS=300
# Reject place candidates whose evidence has not been reviewed by the user.
CANDIDATE_REVIEW_ENABLED=false
# Allow the supervisor to mint a backup plan alongside the locked main plan.
CONVERSATIONAL_BACKUP_ENABLED=true
# Surface partner-search results (restaurants, hotels) inside the itinerary.
PARTNER_SEARCH_ENABLED=false
# Real-time collaborative editing of plans (Yjs/websocket). Disabled by default.
REALTIME_COLLABORATION_ENABLED=false
# Place resolution uses the catalog first, then Google Maps via Playwright.
PLACE_RESOLVER_PROVIDER=google_maps_scraper
# Compose uses the shared sidecar work directory. For a native host install,
# clear WORK_DIR and set EXECUTABLE=google-maps-scraper instead.
GOOGLE_MAPS_SCRAPER_EXECUTABLE=
GOOGLE_MAPS_SCRAPER_WORK_DIR=/app/var/google-maps-scraper
GOOGLE_MAPS_SCRAPER_TIMEOUT_SECONDS=90
GOOGLE_MAPS_SCRAPER_MAX_ALIAS_QUERIES=1
GOOGLE_MAPS_SCRAPER_MAX_CONCURRENCY=2
# Self-hosted Valhalla and OpenTripPlanner do not require API keys.
# Set ROUTE_PROVIDER=geodesic to disable network routing explicitly.
ROUTE_PROVIDER=valhalla
ITINERARY_OPTIMIZER_MODE=route_first
VALHALLA_BASE_URL=http://localhost:8002
VALHALLA_TIMEOUT_SECONDS=15
VALHALLA_MIN_INTERVAL_SECONDS=0
OPENTRIPPLANNER_BASE_URL=http://localhost:8080/otp/gtfs/v1
OPENTRIPPLANNER_TIMEOUT_SECONDS=35
# Use development_shifted_2018 only with the explicitly shifted dev fixture.
OPENTRIPPLANNER_SCHEDULE_STATUS=current
