# Application
APP_NAME=Travel
APP_ENV=development
BACKEND_PORT=8000
VALHALLA_PORT=8002
OPENTRIPPLANNER_PORT=8080
PIP_INDEX_URL=https://pypi.org/simple

# Docker-only settings. Compose passes these values through unchanged.
tile_urls=https://download.geofabrik.de/asia/vietnam-latest.osm.pbf
force_rebuild=false
server_threads=2
build_admins=true
build_time_zones=true
JAVA_TOOL_OPTIONS=-Xmx2500m

# Cloud PostgreSQL connection. Set the value in the deployment environment.
# Example: postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=

# CORS
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Langfuse Observability API (Cloud / Self-hosted)
# Enable Cloud observability: set LANGFUSE_ENABLED=true and provide project API keys from https://cloud.langfuse.com
LANGFUSE_ENABLED=false
# Canonical Langfuse SDK v4 setting. LANGFUSE_HOST remains supported.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_TIMEOUT_SECONDS=10.0
LANGFUSE_FLUSH_TIMEOUT_SECONDS=5.0
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_RELEASE=
LANGFUSE_ENVIRONMENT=
LANGFUSE_CAPTURE_INPUT_OUTPUT=false
LANGFUSE_MAX_CAPTURED_CHARS=2000
LANGFUSE_DEBUG=false

# Development-only bootstrap accounts. Change/remove before production.
AUTH_DEV_SEED_USERS=creator@example.com|Creator Demo|Password123!|creator,admin@travelplanner.local|TravelPlanner Admin|Password123!|admin

# Authentication
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
AUTH_COOKIE_SECURE=false

# MoMo Payment (Sandbox)
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_API_URL=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:3000/orders/{orderId}/result
MOMO_IPN_URL=http://localhost:8000/api/payments/webhooks/momo

# LLM Settings
# One key or a comma-separated key pool. Never commit real keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MIN_INTERVAL_SECONDS=0.0
GEMINI_STT_API_KEYS=
GEMINI_OCR_API_KEYS=
GEMINI_CAPTION_API_KEYS=

# Information Finder web refresh (optional; cache-only mode works without it)
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=5
TAVILY_TIMEOUT_SECONDS=15
GEMINI_AUDIO_MODEL=gemini-3.5-flash-lite
GEMINI_IMAGE_OCR_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30
GEMINI_KEY_COOLDOWN_SECONDS=60
SUPERVISOR_CLASSIFIER_PROVIDER=gemini
SUPERVISOR_LLM_MAX_OUTPUT_TOKENS=256
SUPERVISOR_LLM_FALLBACK_ENABLED=true
SUPERVISOR_LLM_CONFIDENCE_THRESHOLD=0.65
CONVERSATION_MEMORY_REFERENCE_PROVIDER=gemini
CONVERSATION_MEMORY_REFERENCE_CONFIDENCE=0.72
CONVERSATION_MEMORY_REFERENCE_MAX_OUTPUT_TOKENS=320
CONVERSATION_GRAPH_CHECKPOINTER_ENABLED=false
EXPLORER_DRAFT_PROVIDER=gemini
EXPLORER_LLM_MAX_OUTPUT_TOKENS=4000
EXPLORER_SOURCE_MAX_CONCURRENCY=5
EXPLORER_SYNTHESIS_MAX_CONCURRENCY=6
EXPLORER_URL_TIMEOUT_SECONDS=30
EXPLORER_SOURCE_EXTRACTION_TIMEOUT_SECONDS=90
EXPLORER_SOURCE_SYNTHESIS_TIMEOUT_SECONDS=105
EXPLORER_SOURCE_CHUNK_TIMEOUT_SECONDS=60
EXPLORER_URL_CACHE_TTL_SECONDS=604800
EXPLORER_DRAFT_CACHE_TTL_SECONDS=604800
EXPLORER_YTDLP_COOKIE_FILE=
EXPLORER_FRAME_INTERVAL_SECONDS=3
EXPLORER_FRAME_BATCH_SIZE=10
EXPLORER_MAX_FRAMES=48
EXPLORER_FRAME_MAX_CONCURRENCY=5
EXPLORER_AUDIO_CHUNK_COUNT=3
EXPLORER_AUDIO_CHUNK_SECONDS=60
EXPLORER_MAX_VIDEO_SECONDS=180
EXPLORER_MAX_MEDIA_MB=120
INFORMATION_FINDER_EMBEDDING_MODEL=gemini-embedding-001
INFORMATION_FINDER_EMBEDDING_REVISION=
INFORMATION_FINDER_EMBEDDING_OUTPUT_DIMENSIONS=384
INFORMATION_FINDER_EMBEDDING_TIMEOUT_SECONDS=30
INFORMATION_FINDER_MIN_LOCAL_SOURCES=2
INFORMATION_FINDER_SIMILARITY_THRESHOLD=0.65
INFORMATION_FINDER_RELEVANCE_THRESHOLD=0.5
INFORMATION_FINDER_BLOCKED_DOMAINS=
INFORMATION_FINDER_ANSWER_PROVIDER=gemini
INFORMATION_FINDER_LLM_MAX_OUTPUT_TOKENS=800
INFORMATION_FINDER_LLM_MAX_CHARS_PER_SOURCE=4000
INFORMATION_FINDER_LLM_MAX_TOTAL_SOURCE_CHARS=12000
INFORMATION_FINDER_SIMILARITY_THRESHOLD=0.9
INFORMATION_FINDER_LLM_FALLBACK_ENABLED=true
INFORMATION_FINDER_CHUNKING_PROVIDER=gemini_url
INFORMATION_FINDER_CHUNKING_MAX_OUTPUT_TOKENS=8000

# Conversation Supervisor
CONVERSATION_SUPERVISOR_ENABLED=true
CONVERSATION_SUPERVISOR_LLM_ENABLED=true
AUTO_PLAN_MUTATION_ENABLED=true
CONVERSATION_STREAMING_ENABLED=true
CONVERSATION_TURN_TIMEOUT_SECONDS=120.0
CONVERSATION_TURN_STALE_AFTER_SECONDS=300.0

# Candidate Review
CANDIDATE_REVIEW_ENABLED=false

# Weather
WEATHER_ENABLED=false
WEATHERAPI_KEY=
WEATHERAPI_BASE_URL=https://api.weatherapi.com/v1

# Conversational Backup
CONVERSATIONAL_BACKUP_ENABLED=true

# Partner Search
PARTNER_SEARCH_ENABLED=false

# Realtime Collaboration
REALTIME_COLLABORATION_ENABLED=false

# Place Resolver
PLACE_RESOLVER_PROVIDER=provisional

# Route Provider
ROUTE_PROVIDER=valhalla
ITINERARY_OPTIMIZER_MODE=route_first

VALHALLA_BASE_URL=http://valhalla:8002
VALHALLA_TIMEOUT_SECONDS=60
VALHALLA_GRAPH_VERSION=local
VALHALLA_MIN_INTERVAL_SECONDS=0.0
ITINERARY_LOG_SEARCH_PROGRESS=false

# OpenTripPlanner
OPENTRIPPLANNER_BASE_URL=http://localhost:8080/otp/gtfs/v1
OPENTRIPPLANNER_TIMEOUT_SECONDS=35.0
OPENTRIPPLANNER_SCHEDULE_STATUS=current

# Google Maps Scraper
GOOGLE_MAPS_SCRAPER_ENABLED=true
GOOGLE_MAPS_SCRAPER_TIMEOUT_SECONDS=90.0
GOOGLE_MAPS_SCRAPER_MAX_ALIAS_QUERIES=2
GOOGLE_MAPS_SCRAPER_MAX_CONCURRENCY=2

# Database Place Resolver
DATABASE_PLACE_RESOLVER_TOP_K=5
DATABASE_PLACE_RESOLVER_MINIMUM_SCORE=0.82
DATABASE_PLACE_RESOLVER_MINIMUM_MARGIN=0.08

# YouTube Transcript Worker
EXPLORER_YOUTUBE_AUDIO_MAX_CONCURRENCY=1
YOUTUBE_TRANSCRIPT_MIN_INTERVAL_SECONDS=1.0
YOUTUBE_TRANSCRIPT_WORKER_URL=
YOUTUBE_TRANSCRIPT_WORKER_TOKEN=
YOUTUBE_TRANSCRIPT_WORKER_TIMEOUT_SECONDS=20.0

# URL Reel
PRELOAD_URL_REEL_MODELS=false
URL_REEL_GEMINI_STT_MIN_INTERVAL_SECONDS=2.0
URL_REEL_STT_CHUNK_SECONDS=60.0
URL_REEL_STT_MAX_CONCURRENCY=3
URL_REEL_STT_OVERLAP_SECONDS=2.0
URL_REEL_MAX_FRAMES=72
URL_REEL_MIN_FRAME_INTERVAL_SECONDS=1.0
URL_REEL_FRAME_WIDTH=960
URL_REEL_VISION_BATCH_SIZE=10
URL_REEL_VISION_MAX_CONCURRENCY=5
URL_REEL_VISION_MEDIA_RESOLUTION=MEDIA_RESOLUTION_MEDIUM
URL_REEL_NETWORK_TIMEOUT_SECONDS=30.0
URL_REEL_SUBPROCESS_TIMEOUT_SECONDS=180.0

# URL Import Job
URL_IMPORT_JOB_TIMEOUT_SECONDS=300.0

# Gemini Caption
ENABLE_LLM_EXPLORE_FORMATTER=true
GEMINI_CAPTION_TIMEOUT_SECONDS=60.0
GEMINI_CAPTION_MAX_ATTEMPTS=2
GEMINI_AUDIO_MODEL=gemini-3.5-flash-lite
GEMINI_IMAGE_OCR_MODEL=gemini-3.5-flash-lite

# User Post Media
USER_POST_IMAGE_MAX_BYTES=15728640
USER_POST_VIDEO_MAX_BYTES=104857600
