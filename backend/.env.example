# Configuration for the current FastAPI/LangGraph backend.
#
# The old backend used many JWT, database, provider, and routing variables.
# They are not read by the current backend and should not be copied here.

APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql://travelplanner:travelplanner@localhost:5432/travelplanner
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=5
TAVILY_TIMEOUT_SECONDS=15
GEMINI_API_KEY=api1,api2,api3
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_KEY_COOLDOWN_SECONDS=60
INFORMATION_FINDER_EMBEDDING_MODEL=intfloat/multilingual-e5-small
INFORMATION_FINDER_EMBEDDING_REVISION=
INFORMATION_FINDER_MIN_LOCAL_SOURCES=2
INFORMATION_FINDER_SIMILARITY_THRESHOLD=0.65
INFORMATION_FINDER_RELEVANCE_THRESHOLD=0.5
INFORMATION_FINDER_BLOCKED_DOMAINS=
