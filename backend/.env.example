APP_NAME=VSF Travel API
APP_ENV=local
DATABASE_URL=sqlite:///./vsf_travel.db
BACKEND_CORS_ORIGINS=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
AUTH_COOKIE_SECURE=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_AUDIO_MODEL=gemini-3.5-flash-lite
GEMINI_IMAGE_OCR_MODEL=gemini-3.5-flash-lite
ENABLE_LLM_EXPLORE_FORMATTER=false
PRELOAD_URL_REEL_MODELS=false
