APP_NAME=VSF Travel API
APP_ENV=local
DATABASE_URL=postgresql+psycopg://vsf:vsf@localhost:5432/vsf_travel
BACKEND_CORS_ORIGINS=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
AUTH_COOKIE_SECURE=false
# One key or a comma-separated key pool. Never commit real keys.
GEMINI_API_KEY=key-api1,key-api2
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MIN_INTERVAL_SECONDS=0.0
GEMINI_AUDIO_MODEL=gemini-3.5-flash-lite
GEMINI_IMAGE_OCR_MODEL=gemini-3.5-flash-lite
URL_REEL_MAX_FRAMES=48
URL_REEL_MIN_FRAME_INTERVAL_SECONDS=1.0
URL_REEL_FRAME_WIDTH=960
URL_REEL_VISION_BATCH_SIZE=10
URL_REEL_VISION_MAX_CONCURRENCY=5
URL_REEL_VISION_MEDIA_RESOLUTION=MEDIA_RESOLUTION_MEDIUM
ENABLE_LLM_EXPLORE_FORMATTER=true
PRELOAD_URL_REEL_MODELS=false
# Set to "here" after adding a server-side HERE API key. If HERE cannot resolve
# a candidate, the backend automatically falls back to Nominatim.
PLACE_RESOLVER_PROVIDER=here
HERE_BASE_URL=https://discover.search.hereapi.com
HERE_GEOCODE_BASE_URL=https://geocode.search.hereapi.com
HERE_API_KEY=replace-with-server-side-here-api-key
HERE_TIMEOUT_SECONDS=10
HERE_COUNTRY_CODE=VNM
HERE_LANGUAGE=vi-VN
HERE_MIN_INTERVAL_SECONDS=0.2
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=VSF-Travel-Planner/0.1 (replace-with-operator-contact)
NOMINATIM_TIMEOUT_SECONDS=15
NOMINATIM_MIN_INTERVAL_SECONDS=1
